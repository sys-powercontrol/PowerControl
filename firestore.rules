rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserCompanyId() {
      return request.auth.token.get('company_id', 
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('company_id', '')
          : ''
      );
    }

    function getUserCompanyIds() {
      return request.auth.token.get('company_ids', 
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('company_ids', [])
          : []
      );
    }
    
    function getUserRole() {
      return request.auth.token.get('role', 
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
          : ''
      );
    }
    
    function getUserPermissions() {
      return request.auth.token.get('permissions', 
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', [])
          : []
      );
    }

    function isMaster() {
      return isAuthenticated() && (
        request.auth.token.email == "sys.powercontrol@gmail.com" ||
        getUserRole() == "master"
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isMaster() ||
        getUserRole() == "admin"
      );
    }

    function hasPermission(permissionId) {
      return isMaster() || 
             (getUserRole() == "admin") || 
             (permissionId in getUserPermissions());
    }

    function isActive() {
      return isMaster() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_active', true) == true
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) == true)
          : true
      );
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && isActive() && companyId is string && companyId != '' && (
        isMaster() || 
        getUserCompanyId() == companyId || 
        getUserCompanyIds().hasAny([companyId])
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isMaster() || 
        (resource.data.get('email', '') == request.auth.token.email) ||
        (hasPermission('employees.view') && (
          resource.data.get('company_id', '') == getUserCompanyId() || 
          getUserCompanyIds().hasAny([resource.data.get('company_id', '')])
        )) ||
        (isAdmin() && (
          resource.data.get('company_id', '') == getUserCompanyId() || 
          getUserCompanyIds().hasAny([resource.data.get('company_id', '')])
        ))
      );
      allow create: if isAuthenticated() && (
        (isMaster() && (request.resource.data.get('role', '') != 'master' || request.auth.token.email == "sys.powercontrol@gmail.com")) ||
        (isOwner(userId) && request.resource.data.get('role', '') != 'master') ||
        ((isAdmin() || hasPermission('employees.manage')) && request.resource.data.get('role', '') != 'master')
      );
      allow update: if isAuthenticated() && (
        (isMaster() && (request.resource.data.get('role', '') != 'master' || request.auth.token.email == "sys.powercontrol@gmail.com")) || 
        (isOwner(userId) && request.resource.data.get('role', '') == resource.data.get('role', '') && request.resource.data.get('is_active', true) == resource.data.get('is_active', true)) ||
        ((isAdmin() || hasPermission('employees.manage')) && 
          request.resource.data.get('role', '') != 'master' &&
          resource.data.get('role', '') != 'master' &&
          (resource.data.get('company_id', '') == getUserCompanyId() || getUserCompanyIds().hasAny([resource.data.get('company_id', '')]))
        )
      );
      allow delete: if isAuthenticated() && (isMaster() || (isAdmin() && resource.data.get('role', '') != 'master'));
    }

    match /employees/{id} {
      allow read: if isAuthenticated() && (isMaster() || belongsToCompany(resource.data.get('company_id', '')));
      allow create, update, delete: if isAuthenticated() && (isMaster() || (belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('employees.manage')));
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated() && isActive() && (
        isMaster() || 
        getUserCompanyId() == companyId || 
        getUserCompanyIds().hasAny([companyId])
      );
      allow create: if isAuthenticated() && isActive() && (isMaster() || isAdmin());
      allow update: if isAuthenticated() && isActive() && (
        isMaster() || 
        (isAdmin() && (getUserCompanyId() == companyId || getUserCompanyIds().hasAny([companyId])))
      );
      allow delete: if isAuthenticated() && isMaster();

      match /daily_summaries/{summaryId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId) && (hasPermission('sales.create') || hasPermission('finance.manage') || hasPermission('inventory.manage') || isAdmin() || isMaster());
        allow delete: if isMaster();
      }
    }

    match /daily_summaries/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', ''));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('sales.create') || hasPermission('finance.manage') || hasPermission('inventory.manage') || isAdmin() || isMaster());
      allow delete: if isMaster();
    }

    match /dailyRollups/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', ''));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('sales.create') || hasPermission('sales.view') || isAdmin() || isMaster());
      allow delete: if isMaster();
    }

    match /products/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('products.view') || hasPermission('sales.view') || hasPermission('sales.create'));
      allow create, delete: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('products.manage') || hasPermission('inventory.manage'));
      allow update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('products.manage') || hasPermission('sales.create') || hasPermission('inventory.manage'));
    }

    match /sales/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('sales.view');
      allow create: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('sales.create');
      allow update: if belongsToCompany(resource.data.get('company_id', '')) && belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('sales.create');
      allow delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('sales.delete');
    }

    match /services/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('products.view') || hasPermission('sales.view'));
      allow create, update, delete: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('products.manage');
    }

    match /clients/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('sales.view');
      allow create, update, delete: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('sales.create');
    }

    match /purchases/{id} {
      allow read, create, update, delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('inventory.manage');
    }

    match /bankAccounts/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('finance.view') || hasPermission('sales.create'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('finance.manage') || hasPermission('sales.create') || hasPermission('inventory.manage'));
    }

    match /cashiers/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('finance.view') || hasPermission('sales.create'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('finance.manage') || hasPermission('sales.create') || hasPermission('inventory.manage'));
    }

    match /suppliers/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('finance.view');
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('finance.manage');
    }

    match /sellers/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('sellers.manage') || hasPermission('sales.view') || hasPermission('sales.create'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('sellers.manage');
    }

    match /invoices/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('fiscal.manage') || hasPermission('sales.view'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('fiscal.manage') || hasPermission('sales.create'));
    }

    match /tax_rules/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('fiscal.manage');
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('fiscal.manage');
    }

    match /certificates/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('fiscal.manage');
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('fiscal.manage');
    }

    match /fiscal_inutilizacoes/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('fiscal.manage');
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('fiscal.manage');
    }

    match /invites/{inviteId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (isMaster() || (isAdmin() && belongsToCompany(resource.data.get('company_id', ''))));
      allow create, update: if isAuthenticated() && (isMaster() || (isAdmin() && getUserCompanyId() == request.resource.data.get('company_id', '')) || request.resource.data.get('status', '') == 'ACCEPTED');
      allow delete: if isAuthenticated() && isMaster();
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isMaster() || hasPermission('audit.view'));
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (isMaster() || resource.data.get('user_id', '') == request.auth.uid || (isAdmin() && resource.data.get('company_id', '') == getUserCompanyId()));
      allow create, update: if isAuthenticated() && (isMaster() || request.resource.data.get('user_id', '') == request.auth.uid);
      allow delete: if isAuthenticated() && isMaster();
    }

    match /categories/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('products.view') || hasPermission('sales.view'));
      allow create, update, delete: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('products.manage');
    }

    match /brands/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('products.view') || hasPermission('sales.view'));
      allow create, update, delete: if belongsToCompany(request.resource.data.get('company_id', '')) && hasPermission('products.manage');
    }

    match /movements/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('finance.view') || hasPermission('sales.view'));
      allow create: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('finance.manage') || hasPermission('sales.create') || hasPermission('inventory.manage'));
      allow update: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('finance.manage');
    }

    match /inventory_movements/{id} {
      allow read: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('inventory.manage') || hasPermission('sales.view') || hasPermission('finance.view') || hasPermission('products.view'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('inventory.manage') || hasPermission('sales.create'));
      allow delete: if belongsToCompany(resource.data.get('company_id', '')) && hasPermission('inventory.manage');
    }

    match /accountsReceivable/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('finance.view') || hasPermission('sales.view'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('finance.manage') || hasPermission('sales.create') || hasPermission('inventory.manage'));
    }

    match /accountsPayable/{id} {
      allow read, delete: if belongsToCompany(resource.data.get('company_id', '')) && (hasPermission('finance.view') || hasPermission('inventory.manage'));
      allow create, update: if belongsToCompany(request.resource.data.get('company_id', '')) && (hasPermission('finance.manage') || hasPermission('sales.create') || hasPermission('inventory.manage'));
    }

    match /notifications/{id} {
      allow read, create, update, delete: if isAuthenticated() && (isMaster() || belongsToCompany(resource.data.get('company_id', '')) || belongsToCompany(request.resource.data.get('company_id', '')));
    }

    match /reconciliation_rules/{id} {
      allow read, create, update, delete: if belongsToCompany(resource.data.get('company_id', '')) || belongsToCompany(request.resource.data.get('company_id', ''));
    }

    match /api_configurations/{id} {
      allow read: if isAuthenticated() && isMaster();
      allow write: if isAuthenticated() && isMaster();
    }

    match /system_settings/{id} {
      allow read: if isAuthenticated() && isMaster();
      allow write: if isAuthenticated() && isMaster();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
